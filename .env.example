# Socket Server — Environment Variables
# Copy this file to .env and fill in your values.
#
# This repo runs as TWO instances from one codebase — one per product. Nothing
# in server.js is product-specific (no database, in-memory Maps only, pure
# relay), so the whole difference between the two deployments is this file.
#
# They cannot be one process. See the comment at the top of ecosystem.config.js:
# sessions are keyed on clientId, clientId is an int(11) from each product's own
# clients table, and both sequences start at 1.

# ---------------------------------------------------------------------------
# Names the PM2 process (`${INSTANCE_NAME}-socket`) so the two instances are
# distinguishable in `pm2 list`. Defaults to 'ifilter' when unset, which is what
# keeps the pre-existing iFilter checkout on the process name it was created
# with in July.
INSTANCE_NAME=ifilter

# Port this instance listens on, behind an nginx reverse proxy. Not reachable
# from outside — nginx terminates TLS and proxies the WebSocket upgrade.
PORT=3001

# Used for TWO things, which is worth knowing before you change it:
#   1. verifying admin/sink JWTs issued by that product's dashboard;
#   2. as the LITERAL device token — server.js checks `token !== JWT_SECRET`.
# So this value is baked into the product's APK, and changing it needs an app
# release, not just a restart. It must match:
#   iFilter — AuthMiddleware.php `$secretKey` (hardcoded)
#   iShield — the JWT_SECRET the dashboard's auth-secret.php resolves
JWT_SECRET=iFilter_Secret_Key_2025

# Comma-separated CORS origins — the dashboards that open sessions. A value of
# '*' disables the allowlist entirely; don't.
ALLOWED_ORIGINS=https://panel.ifilter.me,https://ikosher.me,https://dashboard.ifilter.me

# ---------------------------------------------------------------------------
# The iShield instance, for reference. Its .env is the same four keys:
#
#   INSTANCE_NAME=ishield
#   PORT=3002
#   JWT_SECRET=iShield_Secret_Key_2025
#   ALLOWED_ORIGINS=https://dashboard.shielder.cloud
